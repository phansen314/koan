{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unblock-input",
  "type": "object",
  "required": ["id", "blockers"],
  "properties": {
    "id": { "$ref": "task-file#/properties/id" },
    "blockers": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "additionalProperties": false
}
