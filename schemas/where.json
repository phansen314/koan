{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "where",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "types#/$defs/ref",
          "description": "Subject."
        },
        "file": {
          "$ref": "types#/$defs/abs-path"
        }
      },
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "file"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "result": {
      "$ref": "location"
    }
  }
}
