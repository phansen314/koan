{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding",
  "type": "object",
  "required": ["kind", "message", "paths", "ids", "repairable"],
  "properties": {
    "kind": {
      "enum": ["temp-leftover", "id-above-counter", "dangling-reference", "stale-claim", "orphan-notes", "duplicate-id", "cycle", "unusable-file", "old-format", "skipped-entry"]
    },
    "message": { "type": "string", "description": "What is wrong and what to do about it." },
    "paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ids": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" }
    },
    "repairable": { "type": "boolean", "description": "Whether repair would fix it." }
  },
  "additionalProperties": false
}
