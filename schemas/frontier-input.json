{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontier-input",
  "type": "object",
  "required": [],
  "properties": {
    "folder": { "$ref": "folder-path", "default": "/" },
    "recursive": { "type": "boolean", "default": true },
    "tags_any": {
      "type": "array",
      "items": { "$ref": "task-file#/$defs/name" },
      "uniqueItems": true
    },
    "tags_all": {
      "type": "array",
      "items": { "$ref": "task-file#/$defs/name" },
      "uniqueItems": true
    },
    "limit": { "type": "integer", "minimum": 1 },
    "fields": {
      "type": "array",
      "items": { "$ref": "task#/$defs/field" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
