{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-file",
  "type": "object",
  "required": ["schema", "claims"],
  "properties": {
    "schema": { "const": 2 },
    "claims": {
      "type": "object",
      "patternProperties": { "^[1-9][0-9]{0,14}$": { "$ref": "#/$defs/claim" } },
      "additionalProperties": false,
      "description": "One entry per claimed task, keyed by ID."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["claimed_at", "extra"],
      "properties": { "claimed_at": { "$ref": "task-file#/$defs/timestamp" }, "extra": { "type": "object" } },
      "additionalProperties": false
    }
  }
}
