{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-create",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "allOf": [
            {
              "$ref": "types#/$defs/path"
            },
            {
              "not": {
                "const": "/"
              }
            }
          ],
          "description": "Subject."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "join": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/folder-ref"
          },
          "default": [],
          "description": "The folders it joins."
        },
        "extra": {
          "$ref": "types#/$defs/extra",
          "default": {}
        },
        "notes": {
          "type": "string",
          "default": "",
          "description": "The @notes.md's first content, written by the step that makes the directory."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "id",
        "ref",
        "notes_path",
        "dir",
        "folders_made",
        "gates_made",
        "reblocked"
      ],
      "properties": {
        "id": {
          "$ref": "types#/$defs/id"
        },
        "ref": {
          "$ref": "types#/$defs/kept"
        },
        "notes_path": {
          "$ref": "types#/$defs/abs-path"
        },
        "dir": {
          "$ref": "types#/$defs/abs-path"
        },
        "folders_made": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/folder-at"
          },
          "description": "Every folder made, parents first, this one last."
        },
        "gates_made": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/gate-made"
          },
          "description": "Empty without --join."
        },
        "reblocked": {
          "$ref": "types#/$defs/ids",
          "description": "Ready tasks it made wait, through --join."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
