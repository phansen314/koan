{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migrate-output",
  "type": "object",
  "required": ["from", "to", "converted", "unconverted"],
  "properties": {
    "from": { "type": "integer" },
    "to": { "type": "integer" },
    "converted": { "type": "integer", "minimum": 0 },
    "unconverted": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
