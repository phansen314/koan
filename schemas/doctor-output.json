{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctor-output",
  "type": "object",
  "required": ["healthy", "findings"],
  "properties": {
    "healthy": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding" }
    }
  },
  "additionalProperties": false
}
