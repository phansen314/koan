{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-move",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "folder",
        "to"
      ],
      "properties": {
        "folder": {
          "$ref": "types#/$defs/folder-ref",
          "description": "Subject."
        },
        "to": {
          "allOf": [
            {
              "$ref": "types#/$defs/path"
            },
            {
              "not": {
                "const": "/"
              }
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "id",
        "changed",
        "path",
        "dir",
        "created"
      ],
      "properties": {
        "id": {
          "$ref": "types#/$defs/id"
        },
        "changed": {
          "type": "boolean"
        },
        "path": {
          "$ref": "types#/$defs/path"
        },
        "dir": {
          "$ref": "types#/$defs/abs-path"
        },
        "created": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/folder-at"
          },
          "description": "Missing parents made for the new path, top first; empty when all were there."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
