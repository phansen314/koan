{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delete-folder-output",
  "type": "object",
  "required": ["folder", "deleted", "dependents"],
  "properties": {
    "folder": { "$ref": "folder-path" },
    "deleted": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" },
      "uniqueItems": true
    },
    "dependents": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
