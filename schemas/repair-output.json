{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair-output",
  "type": "object",
  "required": ["repaired", "findings"],
  "properties": {
    "repaired": {
      "type": "array",
      "items": { "$ref": "finding" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding" }
    }
  },
  "additionalProperties": false
}
