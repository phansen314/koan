{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unclaim",
  "$defs": {
    "input": {
      "$ref": "complete#/$defs/input"
    },
    "result": {
      "type": "object",
      "required": [
        "unclaimed"
      ],
      "properties": {
        "unclaimed": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/id"
          },
          "uniqueItems": true,
          "description": "The tasks whose claim it ended. Input order."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
