{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "init-output",
  "type": "object",
  "required": ["root", "state_path", "created"],
  "properties": {
    "root": { "type": "string" },
    "state_path": { "type": "string" },
    "created": {
      "type": "array",
      "items": { "enum": ["root", "metadata", "state"] },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
