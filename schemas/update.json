{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "update",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "refs"
      ],
      "minProperties": 2,
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "$ref": "show#/$defs/input/properties/ref"
          },
          "minItems": 1,
          "description": "Subject: tasks and folders, mixed."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "null clears a folder's title; a task refuses it."
        },
        "priority": {
          "$ref": "types#/$defs/priority",
          "description": "Tasks only."
        },
        "tags_add": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "description": "Tasks only."
        },
        "tags_remove": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "description": "Tasks only."
        },
        "tags_replace_all": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "description": "Tasks only."
        },
        "extra_merge": {
          "$ref": "types#/$defs/extra"
        },
        "extra_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_replace_all": {
          "$ref": "types#/$defs/extra"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "tags_replace_all",
              "tags_add"
            ]
          },
          {
            "required": [
              "tags_replace_all",
              "tags_remove"
            ]
          },
          {
            "required": [
              "extra_replace_all",
              "extra_merge"
            ]
          },
          {
            "required": [
              "extra_replace_all",
              "extra_remove"
            ]
          }
        ]
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "updated"
      ],
      "properties": {
        "updated": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/id"
          },
          "uniqueItems": true,
          "description": "The subjects it changed. Input order."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
