{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "$ref": "types#/$defs/task-ref",
          "description": "Subject."
        },
        "extra": {
          "$ref": "types#/$defs/extra",
          "default": {}
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "claim"
      ],
      "properties": {
        "claim": {
          "$ref": "claim-record"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
