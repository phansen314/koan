{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim",
  "type": "object",
  "required": [
    "task",
    "claimed_at",
    "extra"
  ],
  "properties": {
    "task": {
      "$ref": "types#/$defs/id"
    },
    "claimed_at": {
      "$ref": "types#/$defs/timestamp"
    },
    "extra": {
      "$ref": "types#/$defs/extra",
      "description": "The caller's, never interpreted: who holds it, for instance."
    }
  },
  "unevaluatedProperties": false
}
