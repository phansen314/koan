{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/task-ref"
          },
          "minItems": 1,
          "description": "Subject."
        },
        "extra": {
          "$ref": "types#/$defs/extra",
          "default": {},
          "description": "Kept with every claim it makes."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "claimed"
      ],
      "properties": {
        "claimed": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/id"
          },
          "uniqueItems": true,
          "description": "The tasks it claimed. Input order."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
