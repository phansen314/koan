{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-join",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "folder",
        "join"
      ],
      "properties": {
        "folder": {
          "$ref": "types#/$defs/folder-ref",
          "description": "Subject."
        },
        "join": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/folder-ref"
          },
          "minItems": 1,
          "description": "Object: the folders joined, the words after the subject."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "$ref": "task-block#/$defs/result"
    }
  }
}
