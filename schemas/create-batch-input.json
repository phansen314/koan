{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "create-batch-input",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "folder": { "$ref": "folder-ref", "default": "/" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "type": "object", "required": ["title"], "properties": { "ref": { "$ref": "task-file#/$defs/name", "description": "A name for this task within the batch. Never stored." }, "title": { "type": "string", "description": "Trimmed, then checked against the title rule." }, "folder": { "$ref": "folder-ref", "description": "Defaults to the batch's folder." }, "priority": { "$ref": "task-file#/properties/priority", "default": null }, "tags": { "$ref": "task-file#/properties/tags", "default": [] }, "blocked_by": { "type": "array", "uniqueItems": true, "default": [], "items": { "anyOf": [{ "$ref": "task-file#/properties/id" }, { "type": "string", "pattern": "^@[1-9][0-9]{0,14}$" }, { "$ref": "task-file#/$defs/name" }] }, "description": "IDs of existing tasks (an integer, or a string with @), and refs of earlier tasks in the batch (a string without)." }, "extra": { "$ref": "task-file#/properties/extra", "default": {} }, "notes": { "type": "string", "default": "", "description": "The initial content of the .md." } }, "additionalProperties": false }
    }
  },
  "additionalProperties": false
}
