{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "complete",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/task-ref"
          },
          "minItems": 1,
          "description": "Subject."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "completed",
        "unclaimed",
        "released"
      ],
      "properties": {
        "completed": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/id"
          },
          "uniqueItems": true,
          "description": "The tasks it completed. Input order."
        },
        "unclaimed": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/id"
          },
          "uniqueItems": true,
          "description": "The tasks completed whose claim it ended, in completed's order."
        },
        "released": {
          "$ref": "types#/$defs/ids",
          "description": "Open tasks it made ready."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
