{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bind",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "folder",
        "dir"
      ],
      "properties": {
        "folder": {
          "$ref": "types#/$defs/folder-ref",
          "description": "Subject. Never the root, which has no ID."
        },
        "dir": {
          "$ref": "types#/$defs/abs-path",
          "description": "Object."
        },
        "force": {
          "type": "boolean",
          "default": false
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "dir",
        "marker",
        "changed",
        "binding",
        "replaced"
      ],
      "properties": {
        "dir": {
          "$ref": "types#/$defs/abs-path"
        },
        "marker": {
          "$ref": "types#/$defs/abs-path",
          "description": "The marker.json."
        },
        "changed": {
          "type": "boolean",
          "description": "false when the marker there already held this binding, which is left as it is."
        },
        "binding": {
          "$ref": "marker-file",
          "description": "What it holds."
        },
        "replaced": {
          "type": "boolean",
          "description": "Whether it replaced a marker holding another binding."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
