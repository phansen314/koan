{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-delete",
  "$defs": {
    "input": {
      "$ref": "task-show#/$defs/input"
    },
    "result": {
      "type": "object",
      "required": [
        "removed",
        "released"
      ],
      "properties": {
        "removed": {
          "$ref": "types#/$defs/ids"
        },
        "released": {
          "$ref": "types#/$defs/ids"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
