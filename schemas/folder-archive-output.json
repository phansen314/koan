{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-archive-output",
  "type": "object",
  "required": ["id", "path", "changed", "archived", "ids", "dependents"],
  "properties": {
    "id": { "$ref": "task-file#/properties/id" },
    "path": { "$ref": "folder-path", "description": "The path it had in the tree." },
    "changed": { "const": true },
    "archived": { "type": "string", "description": "The absolute path of its directory in the archive." },
    "ids": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Every task and folder ID archived, its own included. Ascending."
    },
    "dependents": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" },
      "uniqueItems": true,
      "description": "The tasks and folders whose blocked_by changed. Ascending."
    }
  },
  "additionalProperties": false
}
