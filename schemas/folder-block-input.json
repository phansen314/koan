{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-block-input",
  "type": "object",
  "required": ["folder", "blocked_by"],
  "properties": {
    "folder": { "$ref": "folder-ref", "description": "Not the root, which has no folder file." },
    "blocked_by": {
      "type": "array",
      "items": { "$ref": "item-ref" },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Existing tasks and folders to add to the folder's blocked_by."
    }
  },
  "additionalProperties": false
}
