{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mv",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "refs"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "$ref": "show#/$defs/input/properties/ref"
          },
          "minItems": 1,
          "description": "Subject: tasks and folders, mixed."
        },
        "dest": {
          "$ref": "types#/$defs/folder-ref",
          "description": "Object: a folder that exists, to move them into; otherwise the one folder's new path."
        },
        "into": {
          "$ref": "types#/$defs/folder-ref",
          "description": "The folder to move them into: -t, --into."
        },
        "rename": {
          "type": "boolean",
          "default": false,
          "description": "dest is the one folder's new path, never a folder to move into: -T, --rename."
        }
      },
      "oneOf": [
        {
          "required": [
            "dest"
          ]
        },
        {
          "required": [
            "into"
          ]
        }
      ],
      "if": {
        "required": [
          "rename"
        ],
        "properties": {
          "rename": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "dest"
        ],
        "properties": {
          "refs": {
            "maxItems": 1
          }
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "moved"
      ],
      "properties": {
        "moved": {
          "type": "array",
          "description": "The tasks and folders that moved. Input order.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "ref",
              "notes_path",
              "dir"
            ],
            "properties": {
              "id": {
                "$ref": "types#/$defs/id"
              },
              "ref": {
                "$ref": "types#/$defs/kept",
                "description": "Its kept text, with its new path."
              },
              "notes_path": {
                "$ref": "types#/$defs/abs-path"
              },
              "dir": {
                "anyOf": [
                  {
                    "$ref": "types#/$defs/abs-path"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "A folder's directory; null for a task."
              }
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    }
  }
}
