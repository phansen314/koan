{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbind",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "dir"
      ],
      "properties": {
        "dir": {
          "$ref": "types#/$defs/abs-path",
          "description": "Subject."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "dir",
        "marker",
        "changed"
      ],
      "properties": {
        "dir": {
          "$ref": "types#/$defs/abs-path"
        },
        "marker": {
          "$ref": "types#/$defs/abs-path",
          "description": "The marker.json, removed or not there."
        },
        "changed": {
          "type": "boolean",
          "description": "false when there was no marker."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
