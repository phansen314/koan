{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-move",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "task",
        "to"
      ],
      "properties": {
        "task": {
          "$ref": "types#/$defs/task-ref",
          "description": "Subject."
        },
        "to": {
          "$ref": "types#/$defs/folder-ref"
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "id",
        "changed",
        "notes_path"
      ],
      "properties": {
        "id": {
          "$ref": "types#/$defs/id"
        },
        "changed": {
          "type": "boolean"
        },
        "notes_path": {
          "$ref": "types#/$defs/abs-path"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
