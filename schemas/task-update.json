{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-update",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "task"
      ],
      "minProperties": 2,
      "properties": {
        "task": {
          "$ref": "types#/$defs/task-ref",
          "description": "Subject."
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "$ref": "types#/$defs/priority"
        },
        "tags_add": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "uniqueItems": true
        },
        "tags_remove": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "uniqueItems": true
        },
        "tags_replace_all": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "uniqueItems": true
        },
        "extra_merge": {
          "$ref": "types#/$defs/extra"
        },
        "extra_remove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "extra_replace_all": {
          "$ref": "types#/$defs/extra"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "tags_replace_all",
              "tags_add"
            ]
          },
          {
            "required": [
              "tags_replace_all",
              "tags_remove"
            ]
          },
          {
            "required": [
              "extra_replace_all",
              "extra_merge"
            ]
          },
          {
            "required": [
              "extra_replace_all",
              "extra_remove"
            ]
          }
        ]
      },
      "unevaluatedProperties": false
    },
    "result": {
      "$ref": "#/$defs/id-only"
    },
    "id-only": {
      "type": "object",
      "required": [
        "id",
        "changed"
      ],
      "properties": {
        "id": {
          "$ref": "types#/$defs/id"
        },
        "changed": {
          "type": "boolean",
          "description": "false when the write changed nothing."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
