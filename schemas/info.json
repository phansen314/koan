{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "info",
  "$defs": {
    "input": {
      "type": "object",
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "root",
        "tree",
        "archived",
        "log",
        "database",
        "state",
        "format",
        "next_id",
        "last_seq",
        "counts",
        "error"
      ],
      "properties": {
        "root": {
          "$ref": "types#/$defs/abs-path"
        },
        "tree": {
          "$ref": "types#/$defs/abs-path"
        },
        "archived": {
          "$ref": "types#/$defs/abs-path",
          "description": "The archive's directory, archived/."
        },
        "log": {
          "$ref": "types#/$defs/abs-path",
          "description": "The rotated log's directory, log/."
        },
        "database": {
          "$ref": "types#/$defs/abs-path"
        },
        "state": {
          "enum": [
            "usable",
            "not-initialized",
            "unsupported-format",
            "corrupt"
          ]
        },
        "format": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The database's; null when there is none, or it can't be read."
        },
        "next_id": {
          "anyOf": [
            {
              "$ref": "types#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null unless usable, and once the last ID is issued."
        },
        "last_seq": {
          "anyOf": [
            {
              "$ref": "types#/$defs/seq"
            },
            {
              "type": "null"
            }
          ],
          "description": "The highest seq issued, rotated or not. Null unless usable, and null when the root has issued none."
        },
        "counts": {
          "anyOf": [
            {
              "type": "null",
              "description": "Unless usable."
            },
            {
              "type": "object",
              "required": [
                "tasks",
                "folders",
                "claims",
                "pending",
                "stuck",
                "events"
              ],
              "properties": {
                "tasks": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Live tasks."
                },
                "folders": {
                  "type": "integer",
                  "minimum": 0
                },
                "claims": {
                  "type": "integer",
                  "minimum": 0
                },
                "pending": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Pending filesystem steps, stuck ones included."
                },
                "stuck": {
                  "type": "integer",
                  "minimum": 0
                },
                "events": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Events in the table, those rotated into log/ left out."
                }
              },
              "unevaluatedProperties": false
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "error"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unless usable, the error other commands fail with."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
