{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "info",
  "$defs": {
    "input": {
      "type": "object",
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "root",
        "tree",
        "archive",
        "database",
        "state",
        "format",
        "next_id",
        "tasks",
        "folders",
        "claims",
        "pending",
        "stuck",
        "error"
      ],
      "properties": {
        "root": {
          "$ref": "types#/$defs/abs-path"
        },
        "tree": {
          "$ref": "types#/$defs/abs-path"
        },
        "archive": {
          "$ref": "types#/$defs/abs-path"
        },
        "database": {
          "$ref": "types#/$defs/abs-path"
        },
        "state": {
          "enum": [
            "usable",
            "not-initialized",
            "unsupported-format",
            "corrupt"
          ]
        },
        "format": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The database's; null when there is none, or it can't be read."
        },
        "next_id": {
          "anyOf": [
            {
              "$ref": "types#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null unless usable, and once the last ID is issued."
        },
        "tasks": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Live tasks. This and the counts below are null unless usable."
        },
        "folders": {
          "type": [
            "integer",
            "null"
          ]
        },
        "claims": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pending": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Pending filesystem steps, stuck ones included."
        },
        "stuck": {
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "error"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unless usable, the error other commands fail with."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
