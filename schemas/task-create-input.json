{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-create-input",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "description": "Trimmed, then checked against the title rule." },
    "folder": { "$ref": "folder-ref", "default": "/" },
    "priority": { "$ref": "task-file#/properties/priority", "default": null },
    "tags": {
      "$ref": "task-file#/properties/tags",
      "default": []
    },
    "blocked_by": {
      "type": "array", "items": { "$ref": "item-ref" }, "uniqueItems": true,
      "default": [],
      "description": "Existing tasks and folders the new task waits on."
    },
    "blocks": {
      "type": "array", "items": { "$ref": "item-ref" }, "uniqueItems": true,
      "default": [],
      "description": "Existing tasks and folders that wait on the new one."
    },
    "extra": {
      "$ref": "task-file#/properties/extra",
      "default": {}
    },
    "notes": { "type": "string", "default": "", "description": "The initial content of the .md." }
  },
  "additionalProperties": false
}
