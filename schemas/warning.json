{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warning",
  "type": "object",
  "required": ["kind", "message", "ids", "paths"],
  "properties": {
    "kind": {
      "enum": ["unusable-file", "dangling-reference", "id-above-counter"]
    },
    "message": { "type": "string" },
    "ids": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" }
    },
    "paths": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
