{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marker-bind-output",
  "type": "object",
  "required": ["id", "path", "dir", "marker", "changed"],
  "properties": {
    "id": { "$ref": "task-file#/properties/id", "description": "The folder's ID." },
    "path": { "$ref": "folder-path", "description": "The folder's path." },
    "dir": { "type": "string", "description": "The directory bound, at its real path." },
    "marker": { "type": "string", "description": "The absolute path of the marker: <dir>/.koan/marker.json." },
    "changed": { "type": "boolean" }
  },
  "additionalProperties": false
}
