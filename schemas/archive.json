{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "refs"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "$ref": "show#/$defs/input/properties/ref"
          },
          "minItems": 1,
          "description": "Subject: tasks and folders, mixed."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "archived",
        "removed"
      ],
      "properties": {
        "archived": {
          "type": "array",
          "description": "Each subject, in input order.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "ref",
              "notes_path",
              "dir",
              "json"
            ],
            "properties": {
              "id": {
                "$ref": "types#/$defs/id"
              },
              "ref": {
                "$ref": "types#/$defs/kept",
                "description": "Its kept text, with the path it had."
              },
              "notes_path": {
                "anyOf": [
                  {
                    "$ref": "types#/$defs/abs-path"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Its archived notes; null for a task archived without a notes file."
              },
              "dir": {
                "anyOf": [
                  {
                    "$ref": "types#/$defs/abs-path"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "A folder's archived directory; null for a task."
              },
              "json": {
                "$ref": "types#/$defs/abs-path",
                "description": "The JSON beside it."
              }
            },
            "unevaluatedProperties": false
          }
        },
        "removed": {
          "$ref": "types#/$defs/ids",
          "description": "Every ID that left the tree, now retired."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
