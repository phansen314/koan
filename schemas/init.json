{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "init",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "ids_from": {
          "anyOf": [
            {
              "$ref": "types#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: a new root issues from 1."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "root",
        "tree",
        "archived",
        "log",
        "database",
        "made",
        "first_id"
      ],
      "properties": {
        "root": {
          "$ref": "types#/$defs/abs-path"
        },
        "tree": {
          "$ref": "types#/$defs/abs-path"
        },
        "archived": {
          "$ref": "types#/$defs/abs-path",
          "description": "The archive's directory, archived/."
        },
        "log": {
          "$ref": "types#/$defs/abs-path",
          "description": "The rotated log's directory, log/."
        },
        "database": {
          "$ref": "types#/$defs/abs-path"
        },
        "made": {
          "type": "array",
          "items": {
            "enum": [
              "root",
              "tree",
              "archived",
              "log",
              "database"
            ]
          },
          "uniqueItems": true,
          "description": "What this run made; empty when all of it was there."
        },
        "first_id": {
          "$ref": "types#/$defs/id"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
