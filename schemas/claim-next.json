{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-next",
  "$defs": {
    "input": {
      "type": "object",
      "allOf": [
        {
          "$ref": "task-list#/$defs/filter"
        }
      ],
      "properties": {
        "extra": {
          "$ref": "types#/$defs/extra",
          "default": {}
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "anyOf": [
            {
              "$ref": "task"
            },
            {
              "type": "null"
            }
          ],
          "description": "The task it claimed, its claim included; null when the frontier was empty."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
