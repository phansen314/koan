{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-mv",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "folders"
      ],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/folder-ref"
          },
          "minItems": 1,
          "description": "Subject."
        },
        "dest": {
          "$ref": "types#/$defs/folder-ref",
          "description": "Object: a folder that exists, to move them into; otherwise the one folder's new path."
        },
        "into": {
          "$ref": "types#/$defs/folder-ref",
          "description": "The folder to move them into: -t, --into."
        },
        "rename": {
          "type": "boolean",
          "default": false,
          "description": "dest is the new path, never a folder to move into: -T, --rename."
        }
      },
      "oneOf": [
        {
          "required": [
            "dest"
          ]
        },
        {
          "required": [
            "into"
          ]
        }
      ],
      "if": {
        "required": [
          "rename"
        ],
        "properties": {
          "rename": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "dest"
        ],
        "properties": {
          "folders": {
            "maxItems": 1
          }
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "moved"
      ],
      "properties": {
        "moved": {
          "type": "array",
          "description": "The folders that moved. Input order.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "dir"
            ],
            "properties": {
              "id": {
                "$ref": "types#/$defs/id"
              },
              "path": {
                "$ref": "types#/$defs/path"
              },
              "dir": {
                "$ref": "types#/$defs/abs-path"
              }
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    }
  }
}
