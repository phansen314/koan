{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delete-folder-input",
  "type": "object",
  "required": ["folder"],
  "properties": {
    "folder": { "$ref": "folder-ref" },
    "recursive": { "type": "boolean", "default": false },
    "force": { "type": "boolean", "default": false, "description": "With recursive, remove material too: every visible entry that is not koan's." }
  },
  "additionalProperties": false
}
