{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "info-output",
  "type": "object",
  "required": ["root", "tree", "archive", "state_path", "state", "missing", "format", "last_id", "claims", "error"],
  "properties": {
    "root": { "type": "string" },
    "tree": { "type": "string", "description": "The tree's directory: the folder /." },
    "archive": { "type": "string", "description": "The archive's directory, there or not." },
    "state_path": { "type": "string" },
    "state": {
      "enum": ["not-initialized", "unusable", "needs-migration", "too-new", "usable"]
    },
    "missing": {
      "type": "array",
      "items": { "enum": ["root", "metadata", "tree", "state"] },
      "uniqueItems": true,
      "description": "When not-initialized, what is missing; otherwise empty."
    },
    "format": {
      "type": ["integer", "null"]
    },
    "last_id": {
      "type": ["integer", "null"]
    },
    "claims": {
      "type": ["integer", "null"]
    },
    "error": {
      "anyOf": [{ "$ref": "error" }, { "type": "null" }],
      "description": "When unusable, the error other commands fail with; otherwise null."
    }
  },
  "additionalProperties": false
}
