{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "move-output",
  "type": "object",
  "required": ["task", "folders_created", "changed"],
  "properties": {
    "task": { "$ref": "task" },
    "folders_created": {
      "type": "array",
      "items": { "$ref": "folder-path" }
    },
    "changed": { "type": "boolean" }
  },
  "additionalProperties": false
}
