{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error",
  "type": "object",
  "required": ["kind", "rule", "message", "ids", "folders", "paths", "problems", "changed_paths"],
  "properties": {
    "kind": {
      "enum": ["usage", "invalid-input", "not-initialized", "corrupt", "unsupported-format", "migration-pending", "busy", "not-found", "conflict", "io", "internal"]
    },
    "rule": {
      "type": ["string", "null"],
      "description": "For conflict, which rule refused the input; null for every other kind."
    },
    "message": { "type": "string", "description": "One sentence for a person. Not for parsing." },
    "ids": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" }
    },
    "folders": {
      "type": "array",
      "items": { "$ref": "folder-path" }
    },
    "paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "problems": {
      "type": "array",
      "items": { "type": "object", "required": ["field", "reason"], "properties": { "field": { "type": "string", "description": "A JSON Pointer into the input or the file." }, "reason": { "type": "string" } }, "additionalProperties": false }
    },
    "changed_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What the command created, rewrote, or removed before it failed."
    }
  },
  "additionalProperties": false,
  "allOf": [{ "if": { "properties": { "kind": { "const": "conflict" } } }, "then": { "properties": { "rule": { "type": "string" } } }, "else": { "properties": { "rule": { "type": "null" } } } }]
}
