{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "why",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "$ref": "types#/$defs/task-ref",
          "description": "Subject."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "id",
        "readiness",
        "blockers",
        "ready"
      ],
      "properties": {
        "id": {
          "$ref": "types#/$defs/id"
        },
        "readiness": {
          "$ref": "types#/$defs/readiness"
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/edge-end"
          },
          "description": "Its open blockers. Ascending by ID."
        },
        "ready": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/id"
          },
          "description": "Ready tasks it waits on, at any depth through open blockers, claimed ones included, since they are the work in progress. Work order."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
