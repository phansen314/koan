{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delete",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "refs"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "$ref": "show#/$defs/input/properties/ref"
          },
          "minItems": 1,
          "description": "Subject: tasks and folders, mixed."
        },
        "contents": {
          "type": "boolean",
          "default": false,
          "description": "Folders only: delete the tasks and folders in them too."
        },
        "material": {
          "type": "boolean",
          "default": false,
          "description": "Folders only: delete the material in them too."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "deleted",
        "removed",
        "unclaimed",
        "released"
      ],
      "properties": {
        "deleted": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/id"
          },
          "uniqueItems": true,
          "description": "The subjects. Input order."
        },
        "removed": {
          "$ref": "types#/$defs/ids",
          "description": "Every task and folder removed: the subjects and everything under them. Ascending."
        },
        "unclaimed": {
          "$ref": "types#/$defs/ids",
          "description": "The tasks removed that had a claim. Ascending."
        },
        "released": {
          "$ref": "types#/$defs/ids",
          "description": "Open tasks it made ready."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
