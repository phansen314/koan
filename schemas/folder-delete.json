{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-delete",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "folders"
      ],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/folder-ref"
          },
          "minItems": 1,
          "description": "Subject."
        },
        "contents": {
          "type": "boolean",
          "default": false
        },
        "material": {
          "type": "boolean",
          "default": false,
          "description": "Delete the material in them too."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "$ref": "task-delete#/$defs/result",
      "description": "removed holds every task and folder removed."
    }
  }
}
