{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-unblock-input",
  "type": "object",
  "required": ["id", "blocked_by"],
  "properties": {
    "id": { "$ref": "task-ref" },
    "blocked_by": {
      "type": "array",
      "items": { "$ref": "task-ref" },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "additionalProperties": false
}
