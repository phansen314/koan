{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folder-list",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "folder": {
          "$ref": "types#/$defs/folder-ref",
          "default": "/",
          "description": "Subject: the folder the command looks under; the root when neither it nor file is given."
        },
        "file": {
          "$ref": "task-list#/$defs/filter/properties/file"
        },
        "direct": {
          "type": "boolean",
          "default": false,
          "description": "Only the folders directly in the folder."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 100,
          "description": "null: every match."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "folder#/$defs/field"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "folders",
        "total",
        "truncated"
      ],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "$ref": "folder#/$defs/partial"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
