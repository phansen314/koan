{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "update-input",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "$ref": "task-file#/properties/id" },
    "title": { "type": "string" },
    "priority": { "$ref": "task-file#/properties/priority" },
    "tags_add": {
      "type": "array",
      "items": { "$ref": "task-file#/$defs/name" },
      "uniqueItems": true
    },
    "tags_remove": {
      "type": "array",
      "items": { "$ref": "task-file#/$defs/name" },
      "uniqueItems": true
    },
    "tags_replace_all": {
      "type": "array",
      "items": { "$ref": "task-file#/$defs/name" },
      "uniqueItems": true
    },
    "extra_merge": { "type": "object" },
    "extra_remove": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "extra_replace_all": { "type": "object" }
  },
  "additionalProperties": false,
  "minProperties": 2
}
