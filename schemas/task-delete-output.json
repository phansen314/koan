{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-delete-output",
  "type": "object",
  "required": ["id", "task", "dependents"],
  "properties": {
    "id": { "$ref": "task-file#/properties/id" },
    "task": {
      "anyOf": [{ "$ref": "task" }, { "type": "null" }],
      "description": "Its record, as it was; null when its task file could not be used."
    },
    "dependents": {
      "type": "array",
      "items": { "$ref": "task-file#/properties/id" },
      "uniqueItems": true,
      "description": "The tasks and folders whose blocked_by changed. Ascending."
    }
  },
  "additionalProperties": false
}
