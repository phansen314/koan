{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "folder": {
          "$ref": "types#/$defs/folder-ref",
          "description": "Subject."
        },
        "file": {
          "$ref": "types#/$defs/abs-path"
        }
      },
      "oneOf": [
        {
          "required": [
            "folder"
          ]
        },
        {
          "required": [
            "file"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "result": {
      "$ref": "brief"
    }
  }
}
