{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "folder": {
          "$ref": "types#/$defs/folder-ref",
          "description": "Subject; the root when neither it nor file is given."
        },
        "file": {
          "$ref": "task-list#/$defs/filter/properties/file"
        }
      },
      "not": {
        "required": [
          "folder",
          "file"
        ]
      },
      "unevaluatedProperties": false
    },
    "result": {
      "$ref": "brief"
    }
  }
}
