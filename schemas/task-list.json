{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-list",
  "$defs": {
    "filter": {
      "type": "object",
      "properties": {
        "folder": {
          "$ref": "types#/$defs/folder-ref",
          "default": "/",
          "description": "Subject: the folder the command looks under; the root when neither it nor file is given."
        },
        "file": {
          "$ref": "types#/$defs/abs-path",
          "description": "Look under the folder this path is in, found as where --file finds it: --file, or --here for the working directory. Given with folder, invalid-input at \"\"."
        },
        "direct": {
          "type": "boolean",
          "default": false,
          "description": "Only what is directly in the folder."
        },
        "tags_any": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Only tasks holding at least one of these tags; empty filters nothing."
        },
        "tags_all": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/tag"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Only tasks holding every one of these tags; empty filters nothing. Given with tags_any, a task must pass both."
        }
      }
    },
    "input": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/filter"
        }
      ],
      "properties": {
        "state": {
          "type": "array",
          "items": {
            "$ref": "types#/$defs/state"
          },
          "uniqueItems": true,
          "minItems": 1,
          "default": [
            "open"
          ]
        },
        "readiness": {
          "type": "array",
          "items": {
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "default": [
            "ready",
            "blocked"
          ],
          "description": "Applies to open tasks; complete tasks that --state lets in pass through."
        },
        "claimed": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "true: only claimed; false: only unclaimed; null: both."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 100,
          "description": "null: every match."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "task#/$defs/field"
          },
          "uniqueItems": true,
          "description": "Left out: every field."
        }
      },
      "unevaluatedProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "tasks",
        "total",
        "truncated"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "task#/$defs/partial"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
