{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "version-output",
  "type": "object",
  "required": ["version", "commit", "commit_time", "dirty", "go", "platform", "format"],
  "properties": {
    "version": { "type": "string" },
    "commit": { "type": "string" },
    "commit_time": { "$ref": "task-file#/$defs/timestamp" },
    "dirty": { "type": "boolean", "description": "Built with uncommitted changes." },
    "go": { "type": "string" },
    "platform": { "type": "string" },
    "format": { "type": "integer", "description": "The one tree format this binary reads and writes." }
  },
  "additionalProperties": false
}
